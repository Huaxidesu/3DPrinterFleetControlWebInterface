# 网页服务环境变量（复制为 .env 后按需修改）
# Docker 一键安装会自动生成随机密码，一般无需手改。

# 监听端口（页面与接口同一端口）
PORT=17890

# 数据目录（插件/主题包、文件模式 JSON 等）
DATA_ROOT=./data

# —— MySQL（Docker / 生产建议开启）——
# USE_MYSQL=1
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=hanye
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=hanye_printer
# SECRETS_MASTER_KEY=long-random-string

# Docker Compose 还会用到（install-docker 自动写入）：
# MYSQL_ROOT_PASSWORD=
# AUTO_IMPORT=1
# IMPORT_FORCE=0

# 局域网扫描网段（NAS/Docker 强烈建议填写）
# 例：路由器 192.168.1.1 → 写 192.168.1
# LAN_SCAN_SUBNETS=192.168.1

# —— 应用集市（目录浏览 / 安装 / 授权心跳）——
# 运行时只认 MARKET_DEVICE_ID + 本机登录用户 ownedApps
# 本机 Docker / next：http://127.0.0.1:3001
# 服务器：http://124.221.92.32:3001
MARKET_BASE_URL=http://124.221.92.32:3001
MARKET_DESKTOP_SECRET=app-market-desktop-please-change-me
# MARKET_DEVICE_ID=从用户中心复制的本机设备ID
# LICENSE_REQUIRED=1
# MARKET_HEARTBEAT_MS=60000
LICENSE_SOFTWARE=hanye-printer-monitor
