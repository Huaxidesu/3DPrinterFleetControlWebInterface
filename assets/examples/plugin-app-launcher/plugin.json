{
  "identifier": "app_launcher",
  "name": "悬浮快捷启动",
  "version": "1.2.0",
  "description": "悬浮快捷启动：本机隐藏助手（Win EXE / Mac App）绑定当前用户后，网页点击只打开自己电脑上的软件。",
  "copyright": "hanye",
  "author": "hanye",
  "available": true,
  "hooks": [
    "register"
  ],
  "modules": [],
  "vars": [
    {
      "key": "enabled",
      "title": "启用悬浮快捷启动",
      "type": "boolean",
      "value": "1"
    },
    {
      "key": "show_limit",
      "title": "默认显示个数（0=全部）",
      "type": "number",
      "value": "0"
    },
    {
      "key": "fab_size",
      "title": "悬浮按钮边长(px)",
      "type": "number",
      "value": "56"
    },
    {
      "key": "fab_corner",
      "title": "默认角落（br右下 / bl左下 / tr右上 / tl左上）",
      "type": "text",
      "value": "br"
    },
    {
      "key": "allow_server_open",
      "title": "允许服务端本机打开（桌面同机有效；远程 Docker 无效）",
      "type": "boolean",
      "value": "1"
    },
    {
      "key": "allow_user_fab",
      "title": "允许每人自定义悬浮图标（关闭则只用管理员全局图）",
      "type": "boolean",
      "value": "1"
    }
  ],
  "clientJs": [
    "client.js"
  ],
  "themeCss": "theme.css",
  "mainFile": "main.js",
  "installFile": "install.js",
  "uninstallFile": "uninstall.js",
  "compatibleSoftwares": [
    "hanye-printer-monitor"
  ]
}
