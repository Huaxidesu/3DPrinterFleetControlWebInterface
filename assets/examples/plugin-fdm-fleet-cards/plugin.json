{
  "identifier": "fdm_fleet_cards",
  "name": "FDM 机群紧凑卡片",
  "version": "1.0.2",
  "description": "保留原 FDM 卡片；一键切换超紧凑机群视图（温度/进度/剩余时间），打印完成盖章，完成时语音播报「名字打印完成」。",
  "copyright": "hanye",
  "available": true,
  "hooks": [
    "register"
  ],
  "vars": [
    {
      "key": "voice_announce",
      "title": "打印完成语音播报",
      "type": "boolean",
      "value": "1"
    },
    {
      "key": "default_compact",
      "title": "进入 FDM 页默认紧凑视图",
      "type": "boolean",
      "value": "0"
    }
  ],
  "clientJs": [
    "client.js"
  ],
  "themeCss": "theme.css",
  "mainFile": "main.js",
  "installFile": "install.js",
  "uninstallFile": "uninstall.js",
  "compatibleSoftwares": [
    "hanye-printer-monitor"
  ]
}
